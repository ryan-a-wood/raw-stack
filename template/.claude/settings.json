{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/node_modules/raw-stack/hooks/after-edit.js\"; [ -f \"$h\" ] || { echo 'raw-stack is not installed: run pnpm install' >&2; exit 2; }; node \"$h\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "h=\"$CLAUDE_PROJECT_DIR/node_modules/raw-stack/hooks/before-stop.js\"; [ -f \"$h\" ] || { echo 'raw-stack is not installed: run pnpm install' >&2; exit 2; }; node \"$h\"",
            "timeout": 300
          }
        ]
      }
    ]
  },
  "permissions": {
    "deny": [
      "Edit(/tsconfig.json)",
      "Edit(/.dependency-cruiser.cjs)",
      "Edit(/.claude/settings.json)",
      "Edit(/pnpm-workspace.yaml)",
      "Write(/tsconfig.json)",
      "Write(/.dependency-cruiser.cjs)",
      "Write(/.claude/settings.json)",
      "Write(/pnpm-workspace.yaml)"
    ]
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": { "source": "github", "repo": "cursor/plugins" }
    }
  },
  "enabledPlugins": {
    "pstack@cursor-plugins": true
  }
}
