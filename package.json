{
  "name": "raw-stack",
  "version": "0.7.0",
  "description": "Shared guardrails for TypeScript projects on Vite+: strict tsconfig, lint rules, deep-module boundaries, property tests, expect tests with approved snapshot changes, and fast agent verify hooks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryan-a-wood/raw-stack.git"
  },
  "type": "module",
  "files": [
    "bin",
    "config",
    "hooks",
    "lib"
  ],
  "bin": {
    "raw-stack": "./bin/raw-stack.js"
  },
  "exports": {
    "./vite": {
      "types": "./config/vite.d.ts",
      "default": "./config/vite.js"
    },
    "./playwright": {
      "types": "./config/playwright.d.ts",
      "default": "./config/playwright.js"
    },
    "./tsconfig.json": "./config/tsconfig.json",
    "./dependency-cruiser": "./config/dependency-cruiser.cjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "dependency-cruiser": "^18.8.0",
    "@swc/core": "^1.16.22",
    "smol-toml": "^1.9.1"
  },
  "peerDependencies": {
    "fast-check": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  }
}
